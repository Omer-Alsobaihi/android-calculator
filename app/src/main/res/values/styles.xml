<resources>
    <style name="CalculatorButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/dark_gray</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="CalculatorButtonOperator" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/orange</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="CalculatorButtonClear" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/red</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="CalculatorButtonEquals" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_weight">4</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/blue</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="Theme.Calculator" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
