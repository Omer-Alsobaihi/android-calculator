<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CalcButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Number" parent="CalcButton">
        <item name="backgroundTint">?attr/colorSurfaceVariant</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="CalcButton.Operator" parent="CalcButton">
        <item name="backgroundTint">@color/operator_color</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CalcButton.Function" parent="CalcButton">
        <item name="backgroundTint">@color/function_color</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="CalcButton.Equals" parent="CalcButton">
        <item name="backgroundTint">@color/equals_color</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

</resources>
