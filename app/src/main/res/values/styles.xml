    <style name="CalculatorButtonClear" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">#FF3B30</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="CalculatorButtonEquals" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_weight">4</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">#007AFF</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="Theme.Calculator" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
